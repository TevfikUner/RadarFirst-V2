# Bu dosyayı ".env" olarak kopyala ve kendi OpenSky bilgilerini gir.
# ".env" dosyası .gitignore'da olmalı, asla commitlenmemeli.

OPENSKY_USERNAME=kullanici_adiniz
OPENSKY_PASSWORD=sifreniz
# (OPENSKY_KULLANICI / OPENSKY_SIFRE adları da kabul edilir; yukarıdakiler önceliklidir.)
# OpenSky ban koruması: günlük sorgu tavanı (bir uçuş = 2 sorgu; bkz. config.py).
# OPENSKY_GUNLUK_MAKS_SORGU=400

# PostgreSQL bağlantı bilgileri (veritabani.py, api_servisi.py,
# mcp_postgres_sunucusu.py tarafından kullanılır).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sifreniz
POSTGRES_DB=Turbulence-db
# API/işçi/demo bu süper kullanıcı OLMAYAN rolle bağlanır (Docker); rolü
# otomasyon/uygulama_rolu_olustur.sh oluşturur. Boşsa POSTGRES_USER kullanılır.
# UYGULAMA_POSTGRES_USER=turbulans_uygulama
# UYGULAMA_POSTGRES_PASSWORD=uzun_ve_rastgele_bir_sifre
# Disk dışı yedek kopyasının gpg parolası (depo dışında tek satırlık dosya, WSL yolu).
# Boşsa disk dışı kopya şifresiz yazılır. Parolayı parola yöneticisine de kaydet.
# YEDEK_PAROLA_DOSYASI=/mnt/c/Users/<kullanici>/.turbulans_yedek_parolasi

# api_servisi.py'nin '/api/v1/*' uç noktalarını korumak için kullandığı statik
# API anahtarı. İstemciler bunu 'X-API-Key' başlığında göndermeli.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ANAHTARI=uzun_ve_rastgele_bir_anahtar_uret
# İsteğe bağlı pilot/EFB anahtarı: sadece okuma, rota simülasyonu, tahmin ve
# canlı uyarılar (silme, kısıtlı saha, model, görev tetikleme için 403).
API_PILOT_ANAHTARI=
# İsteğe bağlı kişi/cihaz başına anahtarlar: 'kimlik:rol:anahtar' virgülle
# (rol: yonetici | pilot). Denetim kaydında (GET /api/v1/denetim) kimlik
# görünür; rotasyon için yeni anahtarı ekle, istemciler geçince eskisini sil.
API_ANAHTARLARI=
# Gerçek kısıtlı saha verisi için (openaip.net profil sayfası, ücretsiz; veri CC BY-NC 4.0).
OPENAIP_API_ANAHTARI=

# İsteğe bağlı: web/mobil bir istemciden tarayıcı üzerinden api_servisi.py'ye
# istek atacaksan, izin verilen kaynakları virgülle ayırarak buraya yaz
# (örn. http://localhost:3000,https://uygulamam.com). Boş/yoksa CORS kapalı.
CORS_IZIN_VERILEN_KAYNAKLAR=

# İsteğe bağlı: /analiz/* isteklerindeki bildirim_webhook_url'in gidebileceği
# host'lar (virgülle ayrılmış, örn. localhost,n8n.sirketim.com). Doluysa
# listede olmayan host'lara webhook gönderilmez (SSRF koruması). Boşsa her
# http(s) host'una izin verilir; link-local/ayrılmış IP'ler her durumda reddedilir.
# Yerel/iç ağdaki n8n için zorunlu (örn. localhost,n8n); boşsa sadece genel adreslere gönderilir.
WEBHOOK_IZIN_VERILEN_HOSTLAR=

# İsteğe bağlı: config.py'deki HEMEN HEMEN HER sabit (TI1_ESIK_HAFIF,
# EDR_OLCEKLENDIRME_KATSAYISI, MAKS_STATE_VECTOR_SATIRI, CIKTI_KLASORU,
# HARITA_MAKS_ANIMASYON_NOKTASI, TRINO_*, ...) kod değiştirmeden burada bir
# ortam değişkeniyle ezilebilir -- bkz. config.py'nin başındaki not. Örnek:
# TI1_ESIK_HAFIF=5e-7

# İsteğe bağlı: api_servisi.py için logging ayarları (bkz. loglama.py).
# LOG_SEVIYESI=INFO
# LOG_DOSYASI=
# LOG_BICIMI=json   (varsayılan: metin)

# İsteğe bağlı: canlı SIGMET ayarları (bkz. config.py, sigmet_saglayici.py).
# >0 ise API, AWC SIGMET'lerini kendi içinde bu aralıkla (dakika) yeniler;
# 0 ise yenileme n8n/cron ile POST /api/v1/sigmet/guncelle'den yapılır.
# SIGMET_OTOMATIK_GUNCELLEME_DAKIKA=15
# SIGMET_KACINILACAK_TEHLIKELER=TURB,MTW,TS,CONVECTIVE,VA,TC

# İsteğe bağlı: canlı GFS ısıtması (Docker'da varsayılan 6 saat; 0 = kapalı). Açıkken
# SAGLIK_GFS_BOSTA_SAAT'ten uzun süre başarılı indirme yoksa /saglik 'bayat' (bozulmus) döner.
# CANLI_ISITMA_SAAT=6
# CANLI_ISITMA_KUTUSU=36,42,26,45      (enlem_min,enlem_maks,boylam_min,boylam_maks)
# CANLI_ISITMA_SAAT_SAYISI=12

# İsteğe bağlı: uçuşa özel ERA5 dilimleri (bkz. era5_saglayici.py). Copernicus
# CDS kimlik dosyası (~/.cdsapirc) docker-compose'da konteynere secret olarak
# (/run/secrets/cdsapirc, salt okunur) bağlanır; imaja/ortam değişkenlerine
# girmez. Yol, docker compose'u çalıştırdığın makinedeki yoldur (WSL'de örn.
# /mnt/c/Users/<kullanici>/.cdsapirc). Boşsa CDS atlanır, ARCO yedeği kullanılır.
# CDSAPI_RC_DOSYASI=
# ERA5_OTOMATIK_INDIRME=true

# İsteğe bağlı: ML ERA5 pencere deposu (bkz. ml/ozellik_deposu.py). Boş = kapalı
# (gece işi eski davranışla yalnızca 3 seviye indirir ve dilimi siler).
# ML_DEPO_KLASORU=ml_ozellik_deposu
# ML_DEPO_BASINC_SEVIYELERI_HPA=350,300,250,225,200,175,150
# ML_DEPO_EK_DEGISKENLER=relative_humidity

# İsteğe bağlı: ML veri işi (bkz. README "Günlük veri bütçesi").
# MODEL_BUTUNLUK_ZORUNLU=false     (true: sha256 kaydı olmayan model yüklenmez; `turbulans-ml --muhurle`)
# ML_GECE_ISI_SAATI=03:00          (UTC; o saatten sonraki ilk açılışta bir kez)
# ML_GECE_MAKS_CDS_ISTEK=30
# API_YAYIN_ADRESI=127.0.0.1       (Docker API portu; ağdaki cihazlar için 0.0.0.0 -- TLS yok, /docs kapanır)
#   0.0.0.0 ya da AG_ACILISI=true: kapalı başlama; zayıf anahtar/şifre, süper kullanıcı, örnek saha, kapalı bütünlükte API/işçi başlamaz
# API_BELGELERI_ACIK=               (true/false; boşsa /docs yalnızca yerel yayında açık)
# ML_IEM_MAKS_BEKLEYEN=5000        (bu kadar PIREP eşleşme bekliyorsa IEM'den yeni gün çekilmez; 0 = sınırsız)
# GUNLUK_VERI_BUTCESI_MB=500       (CDS + MADIS indirmesi, UTC günü başına; 0 = kapalı)

# İsteğe bağlı: canlı ADS-B oturumu (sanal PIREP). adsb.fi: kişisel/ticari olmayan kullanım, atıf zorunlu.
# CANLI_ADSB_ETKIN=false
# CANLI_ADSB_ARALIK_SANIYE=10

# Rota yakıtı ve kabin önerisi (parametrik varsayımlar, kalibre edilmedi)
# ROTA_YAKIT_MODELI=openap          (openap | sabit)
# ROTA_SEYIR_KUTLE_ORANI=0.85       (seyir başı kütlesi = MTOW x oran)
# KABIN_PENCERE_PAYI_DK=15          (kabin önerisinde ± pencere, dakika)
