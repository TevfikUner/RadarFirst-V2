# Bu dosyayı ".env" olarak kopyala ve kendi OpenSky bilgilerini gir.
# ".env" dosyası .gitignore'da olmalı, asla commitlenmemeli.

OPENSKY_USERNAME=kullanici_adiniz
OPENSKY_PASSWORD=sifreniz

# PostgreSQL bağlantı bilgileri (veritabani.py, api_servisi.py,
# mcp_postgres_sunucusu.py tarafından kullanılır).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sifreniz
POSTGRES_DB=Turbulence-db

# api_servisi.py'nin '/api/v1/*' uç noktalarını korumak için kullandığı statik
# API anahtarı. İstemciler bunu 'X-API-Key' başlığında göndermeli.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ANAHTARI=uzun_ve_rastgele_bir_anahtar_uret

# İsteğe bağlı: web/mobil bir istemciden tarayıcı üzerinden api_servisi.py'ye
# istek atacaksan, izin verilen kaynakları virgülle ayırarak buraya yaz
# (örn. http://localhost:3000,https://uygulamam.com). Boş/yoksa CORS kapalı.
CORS_IZIN_VERILEN_KAYNAKLAR=

# İsteğe bağlı: /analiz/* isteklerindeki bildirim_webhook_url'in gidebileceği
# host'lar (virgülle ayrılmış, örn. localhost,n8n.sirketim.com). Doluysa
# listede olmayan host'lara webhook gönderilmez (SSRF koruması). Boşsa her
# http(s) host'una izin verilir; link-local/ayrılmış IP'ler her durumda reddedilir.
WEBHOOK_IZIN_VERILEN_HOSTLAR=

# İsteğe bağlı: config.py'deki HEMEN HEMEN HER sabit (TI1_ESIK_HAFIF,
# EDR_OLCEKLENDIRME_KATSAYISI, MAKS_STATE_VECTOR_SATIRI, CIKTI_KLASORU,
# HARITA_MAKS_ANIMASYON_NOKTASI, TRINO_*, ...) kod değiştirmeden burada bir
# ortam değişkeniyle ezilebilir -- bkz. config.py'nin başındaki not. Örnek:
# TI1_ESIK_HAFIF=5e-7

# İsteğe bağlı: api_servisi.py için logging ayarları (bkz. loglama.py).
# LOG_SEVIYESI=INFO
# LOG_DOSYASI=

# İsteğe bağlı: canlı SIGMET ayarları (bkz. config.py, sigmet_saglayici.py).
# >0 ise API, AWC SIGMET'lerini kendi içinde bu aralıkla (dakika) yeniler;
# 0 ise yenileme n8n/cron ile POST /api/v1/sigmet/guncelle'den yapılır.
# SIGMET_OTOMATIK_GUNCELLEME_DAKIKA=15
# SIGMET_KACINILACAK_TEHLIKELER=TURB,MTW,TS,CONVECTIVE,VA,TC
