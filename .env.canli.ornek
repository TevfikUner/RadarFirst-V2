# YALNIZCA YEREL CANLI DEMO -- .env.demo'nun canlı veri açık hâli (scripts/canli_demo.sh kullanır).
# Kullanım: scripts/canli_demo.sh  (.env yoksa bu dosyayı .env olarak kopyalar)
# Buradaki anahtarlar herkesçe bilinir: bu ayarlarla açılan yığını ağa açma,
# gerçek kurulumda .env.example / .env.uretim.example kullan.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=demo-yerel-veritabani
POSTGRES_DB=Turbulence-db

API_ANAHTARI=demo-yerel-yonetici
API_PILOT_ANAHTARI=demo-yerel-pilot

# Canlı veri: NOAA GFS (UCAR THREDDS) ve AWC SIGMET 15 dk'da bir. Kimlik bilgisi gerektirmez.
# Uçuşa özel ERA5 indirmesi (CDS hesabı gerekir) ve gece ML işi kapalı.
ERA5_OTOMATIK_INDIRME=false
CANLI_HAVA_VERISI_ETKIN=true
SIGMET_OTOMATIK_GUNCELLEME_DAKIKA=15
ML_GECE_ISI_SAATI=

# Canlı demoda sentetik durum taklidi ve arşiv SIGMET fikstürü kapalı: ekrandaki her şey gerçek.
ARIZA_TAKLIDI_ETKIN=false
DEMO_SIGMET_FIKSTURU_YUKLE=false

ALTLIK_KATMANI=esri
