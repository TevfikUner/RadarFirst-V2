# ÜRETİM PROFİLİ -- gerçek bir EFB/operasyon kurulumu için önerilen ayarlar.
# ".env" olarak kopyala, <...> alanlarını doldur. Geliştirme varsayılanlarından
# farkları yorumlarda. Tüm ayarlar: config.py ve .env.example.

# --- Kimlik bilgileri (zorunlu) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=turbulans
POSTGRES_PASSWORD=<uzun-rastgele-sifre>
POSTGRES_DB=turbulans
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ANAHTARI=<uzun-rastgele-anahtar>
# Kokpit cihazlarına SADECE pilot rolünde anahtar verilir; kişi/cihaz başına
# anahtar denetim kaydında kimi gösterir ve tek tek iptal edilebilir.
API_PILOT_ANAHTARI=
API_ANAHTARLARI=<ops-kisi:yonetici:anahtar>,<efb-kuyruk-no:pilot:anahtar>
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# --- Kısıtlı hava sahaları: örnek veri KAPALI, gerçek veri otomatik ---
# Örnek veri (Natural Earth'ten Suriye/Irak) resmi sınır değildir; üretimde
# yüklenmez. openAIP günlük yenilenir (AIRAC + NOTAM kaynaklı değişiklikler);
# iki aralık boyunca başarı yoksa /saglik?derin=true 'bayat' der.
KISITLI_SAHA_ORNEK_VERI_YUKLE=false
OPENAIP_API_ANAHTARI=<openaip-anahtari>
OPENAIP_ULKELER=TR
OPENAIP_OTOMATIK_GUNCELLEME_SAAT=24

# --- Canlı SIGMET: API kendi yeniler, 30 dk'dan eskiyse rota yanıtı uyarır ---
SIGMET_OTOMATIK_GUNCELLEME_DAKIKA=10
SIGMET_BAYATLIK_DAKIKA=30

# --- Uzun işler ayrı worker servisinde (docker-compose 'worker') ---
GOREV_GOMULU_ISCI=false
GOREV_ISCI_SAYISI=2

# --- Yük ve güvenlik ---
ROTA_HESABI_DAKIKADA_MAKS=20
TAHMIN_DAKIKADA_MAKS=60
AGIR_HESAP_MAKS_ESZAMANLI=4
SAGLIK_ONBELLEK_SANIYE=15
# Webhook sadece bu host'lara (örn. şirket içi n8n); boşsa sadece genel adresler.
WEBHOOK_IZIN_VERILEN_HOSTLAR=
# Tarayıcıdan doğrudan erişecek önyüz varsa kaynağı; yoksa boş (CORS kapalı).
CORS_IZIN_VERILEN_KAYNAKLAR=
DENETIM_SAKLAMA_GUN=365

# --- Gözlemlenebilirlik ---
LOG_SEVIYESI=INFO
# json: log toplayıcı (Loki/ELK) için satır başına bir JSON nesnesi.
LOG_BICIMI=json
# Prometheus: GET /metrics, 'Authorization: Bearer <yönetici anahtarı>'.
