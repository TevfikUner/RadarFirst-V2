# YALNIZCA YEREL DEMO -- kimlik bilgisi gerektirmez (OpenSky, CDS, openAIP yok).
# Kullanım: cp .env.demo .env && docker compose --profile demo up -d --build
# Buradaki anahtarlar herkesçe bilinir: bu ayarlarla açılan yığını ağa açma,
# gerçek kurulumda .env.example / .env.uretim.example kullan.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=demo-yerel-veritabani
POSTGRES_DB=Turbulence-db

API_ANAHTARI=demo-yerel-yonetici
API_PILOT_ANAHTARI=demo-yerel-pilot

# Ağsız çalışma: uçuşa özel ERA5 indirmesi, canlı GFS ve SIGMET yenilemesi kapalı.
# Rota ve hava verisi depodaki demo/ paketinden okunur.
ERA5_OTOMATIK_INDIRME=false
CANLI_HAVA_VERISI_ETKIN=false
SIGMET_OTOMATIK_GUNCELLEME_DAKIKA=0
